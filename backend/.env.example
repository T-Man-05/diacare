# =============================================================================
# DiaCare Backend - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values
# NEVER commit .env to version control!
# =============================================================================

# Django Settings
# ----------------
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,10.80.17.231

# Database Configuration
# ----------------------
# For development (SQLite) - leave DATABASE_URL empty
# For production (PostgreSQL):
# DATABASE_URL=postgres://user:password@host:5432/diacare_db
DATABASE_URL=

# CORS Configuration
# ------------------
# Comma-separated list of allowed origins for Flutter app
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT Configuration
# -----------------
# Token lifetimes in minutes
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# AI Chat Proxy (Groq API)
# ------------------------
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# Email Configuration (for password reset)
# ----------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Supabase Migration (temporary - for data migration)
# ---------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
